# Mordomus — exemplo de ambiente (monólito `api`)
# Em dev o compose injeta as variáveis reais; este arquivo documenta a superfície.

APP_NAME="Mordomus"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=json
LOG_LEVEL=debug

# --- banco único do serviço ----------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mordomus
DB_USERNAME=mordomus
DB_PASSWORD=

# --- cache/fila (Redis) -------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=mordomus-cache-
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
REDIS_HOST=redis
REDIS_PORT=6379

# --- e-mail (Mailpit em dev) ---------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@mordomus.app
MAIL_FROM_NAME="{${APP_NAME}}"

# --- JWT de usuário (RS256) ---------------------------------------------------
JWT_USER_SECRET=
JWT_KID=
JWT_RSA_PRIVATE_KEY=/run/mordomus/rsa_private.pem
JWT_RSA_PUBLIC_KEY=/run/mordomus/rsa_public.pem
