{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mordomus/api",
    "type": "project",
    "description": "Mordomus — aplicação Laravel única (monólito modular, ADR-011).",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../packages/php-common",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "mordomus/php-common": "*",
        "php": "^8.3",
        "firebase/php-jwt": "^7.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "opis/json-schema": "^2.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5.12",
        "zircote/swagger-php": "^6.11"
    },
    "autoload": {
        "psr-4": {
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Mordomus\\": "app/",
            "Mordomus\\Identity\\": "app/Modules/Identity/",
            "Mordomus\\Maintenance\\": "app/Modules/Maintenance/",
            "Mordomus\\Scheduling\\": "app/Modules/Scheduling/",
            "Mordomus\\Financial\\": "app/Modules/Financial/",
            "Mordomus\\Notification\\": "app/Modules/Notification/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mordomus\\Phpstan\\": "phpstan/",
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "lint": "pint --test",
        "lint:fix": "pint",
        "analyse": "phpstan analyse --no-progress",
        "contracts": "@php artisan contracts:validate",
        "openapi": "@php vendor/bin/openapi app -o storage/openapi.yaml",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
