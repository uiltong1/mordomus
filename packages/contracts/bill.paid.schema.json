{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordomus.app/contracts/bill.paid.schema.json",
  "title": "bill.paid",
  "description": "Quitação registrada de um vencimento. Sai uma vez por baixa: o endpoint de pagamento é idempotente, então pagar duas vezes não publica duas vezes (TECHSPEC §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "event_id", "occurred_at", "tenant_id", "payload"],
  "properties": {
    "event": { "const": "bill.paid" },
    "event_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "bill_occurrence_id", "bill_id", "paid_by", "amount", "method"],
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "bill_occurrence_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "bill_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "paid_by": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "method": {
          "type": "string",
          "enum": ["pix", "boleto", "debit_card", "credit_card", "cash", "transfer", "other"]
        },
        "due_date": { "type": ["string", "null"], "format": "date" },
        "paid_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}