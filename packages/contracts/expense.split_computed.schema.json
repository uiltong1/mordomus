{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordomus.app/contracts/expense.split_computed.schema.json",
  "title": "expense.split_computed",
  "description": "Cotas de um vencimento calculadas. Sai uma vez por mudança no número: o `dedupe_key` carrega o resumo das cotas, então regra salva sem diferença real e reentrega de fila não viram dois avisos da mesma conta (R5) (TECHSPEC §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "event_id", "occurred_at", "tenant_id", "payload"],
  "properties": {
    "event": { "const": "expense.split_computed" },
    "event_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "bill_occurrence_id", "bill_id", "due_date", "amount", "mode", "shares", "dedupe_key"],
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "bill_occurrence_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "bill_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "due_date": { "type": "string", "format": "date" },
        "amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
        "mode": { "type": "string", "enum": ["EQUAL", "WEIGHTED", "PERCENT", "CUSTOM"] },
        "shares": {
          "type": "array",
          "minItems": 1,
          "description": "Cotas na ordem em que a regra cadastrou os moradores; a soma fecha com `amount` (R5)",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user_id", "share_amount", "settled"],
            "properties": {
              "user_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
              "share_amount": { "type": "string", "pattern": "^-?\\d+\\.\\d{2}$" },
              "settled": { "type": "boolean" }
            }
          }
        },
        "dedupe_key": { "type": "string" }
      }
    }
  }
}
