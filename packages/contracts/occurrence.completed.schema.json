{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mordomus.app/contracts/occurrence.completed.schema.json",
  "title": "occurrence.completed",
  "description": "Check-in do morador, com a data do próximo ciclo já recalculada. Consumidor: Maintenance (cartão do ativo) e Financial (vencimento da conta) (TECHSPEC §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["event", "event_id", "occurred_at", "tenant_id", "payload"],
  "properties": {
    "event": { "const": "occurrence.completed" },
    "event_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "schedule_id",
        "trigger_config_id",
        "subject_type",
        "subject_id",
        "completed_at",
        "next_due_at"
      ],
      "properties": {
        "tenant_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "schedule_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "trigger_config_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "subject_type": { "type": "string", "enum": ["asset", "bill"] },
        "subject_id": { "type": "string", "pattern": "^[0-9a-hjkmnp-tv-z]{26}$" },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Instante do check-in; base do recálculo quando `recalculate_base` é COMPLETION."
        },
        "next_due_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "Próximo vencimento do ciclo. Nulo quando a regra está pausada ou quando o tipo mede a partir da própria conclusão (POST_COMPLETION) e ainda não há âncora."
        }
      }
    }
  }
}
