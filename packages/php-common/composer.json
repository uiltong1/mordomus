{
    "name": "mordomus/php-common",
    "description": "Primitivas compartilhadas do Mordomus: escopo de tenant no Eloquent (TenantContext, BelongsToTenant, TenantGlobalScope) e formato de erro JSON.",
    "type": "library",
    "version": "2.0.0",
    "license": "proprietary",
    "keywords": ["mordomus", "multitenant", "eloquent"],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Mordomus\\Common\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mordomus\\Common\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Mordomus\\Common\\CommonServiceProvider"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
