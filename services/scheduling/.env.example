# Mordomus — exemplo de ambiente (scheduling)
# Em dev o compose injeta as variáveis reais; este arquivo documenta a superfície.

APP_NAME="Mordomus Scheduling"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8004
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- banco exclusivo do serviço (ADR-004) ------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mordomus_scheduling
DB_USERNAME=mordomus
DB_PASSWORD=

# --- cache/fila (Redis) -------------------------------------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
REDIS_HOST=redis
REDIS_PORT=6379

# --- e-mail (Mailpit em dev — ADR-010) ---------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@mordomus.app
MAIL_FROM_NAME="{${APP_NAME}}"

# --- identidade do serviço (ADR-002) -----------------------------------------
SERVICE_NAME=scheduling
JWT_USER_SECRET=
JWT_SERVICE_SECRET=
